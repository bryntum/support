     /**
      * Handle ENTER key press during cell editing
      * Finishes the current edit and moves to the next cell
      */
     onInternalKeyDown(event) {
         const me = this;
         
         // Handle ENTER key to finish editing
         if (event.key === 'Enter' && !event.shiftKey) {
+            // Prevent event from bubbling to parent elements (e.g., Create button)
+            // This fixes the duplicate task creation bug when addNewAtEnd is enabled
+            event.stopPropagation();
+            
             // Finish editing current cell
             me.finishEditing();
             
             // Move to next row if addNewAtEnd is enabled
             if (me.addNewAtEnd) {
                 me.startEditing(me.getNextPosition());
             }
         }
     }
 }

